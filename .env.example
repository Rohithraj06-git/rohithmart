# Database Configuration
DB_URL=jdbc:h2:tcp://localhost:9092/./data/rohithmart
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

# For Local Development / Embedded Mode:
# DB_URL=jdbc:h2:./data/rohithmart;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE

# HikariCP Pool Configuration
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

# Application Configuration
APP_ENV=development
APP_PORT=8080
SESSION_TIMEOUT_MINUTES=30

# AI Chatbot Configuration
AI_CHATBOT_PROVIDER=mock
AI_GEMINI_API_KEY=your_gemini_api_key_here
AI_TIMEOUT_SECONDS=10
AI_RATE_LIMIT_PER_MINUTE=10
