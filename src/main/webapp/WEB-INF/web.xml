<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>RohithMart</display-name>

    <!-- Context Lifecycle Listener: Manages HikariCP Connection Pool & DB Init -->
    <listener>
        <listener-class>com.rohith.rohithmart.listener.AppContextListener</listener-class>
    </listener>

    <!-- Filter 1: Character Encoding Filter (UTF-8) -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.rohith.rohithmart.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Filter 2: Request Logging & MDC Tracking Filter -->
    <filter>
        <filter-name>LoggingFilter</filter-name>
        <filter-class>com.rohith.rohithmart.filter.LoggingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>LoggingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Filter 3: Authentication & Role-Based Access Control Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.rohith.rohithmart.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/buyer/*</url-pattern>
        <url-pattern>/seller/*</url-pattern>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/checkout</url-pattern>
        <url-pattern>/api/v1/cart/*</url-pattern>
        <url-pattern>/api/v1/orders/*</url-pattern>
    </filter-mapping>

    <!-- Session Management Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Custom Error Pages (Prevent Stack Trace Exposure) -->
    <error-page>
        <error-code>400</error-code>
        <location>/WEB-INF/jsp/error/400.jsp</location>
    </error-page>
    <error-page>
        <error-code>401</error-code>
        <location>/WEB-INF/jsp/error/401.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/jsp/error/403.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/jsp/error/500.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/jsp/error/500.jsp</location>
    </error-page>

</web-app>
